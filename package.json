{
  "name": "@runmu.sh/ext-channels",
  "version": "1.1.0",
  "description": "The Channels panel: the game's chat channels as a rail of chips with unread and mention markers, one channel's messages with search, colours and alerts, a composer, and a pop-out per channel, from GMCP Comm.Channel.*.",
  "keywords": [
    "channels",
    "chat",
    "comms",
    "gmcp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/channels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-channels.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-channels/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "schema",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "muclient": {
    "id": "channels",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Channels",
    "description": "The Channels panel: the game's chat channels as a rail of chips with unread and mention markers, one channel's messages with search, colours and alerts, a composer, and a pop-out per channel, from GMCP Comm.Channel.*.",
    "categories": [
      "interface",
      "communication"
    ],
    "contributes": {
      "panels": [
        {
          "id": "channels",
          "title": "Channels",
          "defaultPosition": "right-bottom",
          "order": 20
        },
        {
          "id": "channel",
          "title": "Channel",
          "defaultPosition": "right-bottom",
          "inViewsMenu": false,
          "order": 21
        }
      ],
      "gmcp": [
        {
          "package": "Comm.Channel 1",
          "messages": {
            "Comm.Channel.List": {
              "dir": "in",
              "schema": "schema/list.json"
            },
            "Comm.Channel.Text": {
              "dir": "in",
              "schema": "schema/text.json"
            },
            "Comm.Channel.Players": {
              "dir": "in",
              "schema": "schema/players.json"
            }
          }
        }
      ],
      "contextMenus": [
        {
          "id": "reply",
          "target": "channel-message",
          "title": "Reply to <sender>"
        },
        {
          "id": "copy",
          "target": "channel-message",
          "title": "Copy message"
        }
      ]
    },
    "capabilities": [
      "send-commands"
    ],
    "publisher": "bitmuse"
  }
}
